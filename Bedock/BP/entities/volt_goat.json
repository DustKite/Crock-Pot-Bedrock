{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "crockpot:volt_goat",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "crockpot:is_charged": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "crockpot:volt_goat_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "wheat"
          ],
          "grow_up": {
            "event": "crockpot:grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 7,
          "speed_multiplier": 1.25
        }
      },
      "crockpot:uncharged_state": {
        "minecraft:attack": {
          "damage": 2
        },
        "minecraft:behavior.tempt": {
          "priority": 3,
          "speed_multiplier": 0.8,
          "items": [
            "wheat",
            "crockpot:pow_cake"
          ]
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 4,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 16.0,
              "walk_speed_multiplier": 1.4,
              "sprint_speed_multiplier": 1.5
            }
          ]
        }
      },
      "crockpot:charged_state": {
        "minecraft:is_charged": {},
        "minecraft:attack": {
          "damage": 3
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "within_radius": 16.0,
          "reselect_targets": true,
          "must_see": false,
          "must_see_forget_duration": 3.0,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 16.0
            }
          ]
        },
        "minecraft:timer": {
          "time": 2400.0,
          "looping": false,
          "time_down_event": {
            "event": "crockpot:discharge",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "volt_goat",
          "animal",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.3
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:attack": {
        "damage": 2
      },
      "minecraft:spawn_egg_interaction": {},
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": [
          "wheat"
        ],
        "breeds_with": {
          "crockpot:volt_goat": {}
        }
      },
      "minecraft:behavior.breed": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "bucket"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_component",
                    "subject": "self",
                    "operator": "!=",
                    "value": "minecraft:is_baby"
                  }
                ]
              }
            },
            "use_item": true,
            "swing": true,
            "transform_to_item": "milk_bucket",
            "play_sounds": "milk",
            "interact_text": "action.interact.milk"
          }
        ]
      },
      "minecraft:offspring": {
        "offspring_pairs": {
          "crockpot:volt_goat": "crockpot:volt_goat"
        }
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "lightning"
              },
              "event": "crockpot:become_charged"
            },
            "deals_damage": "no"
          },
          {
            "cause": "fall",
            "deals_damage": "yes",
            "damage_modifier": -10
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.melee_attack": {
        "priority": 1,
        "speed_multiplier": 1.5,
        "track_target": true,
        "reach_multiplier": 1.5
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 2,
        "alert_same_type": false
      },
      "minecraft:behavior.random_stroll": {
        "priority": 8,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:behavior.look_at_player": {
        "priority": 10,
        "look_distance": 6.0
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:leashable": {},
      "minecraft:nameable": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/volt_goat.json"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 95,
                "add": {
                  "component_groups": [
                    "crockpot:uncharged_state"
                  ]
                }
              },
              {
                "weight": 5,
                "add": {
                  "component_groups": [
                    "crockpot:volt_goat_baby",
                    "crockpot:uncharged_state"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": {
          "component_groups": [
            "crockpot:volt_goat_baby",
            "crockpot:uncharged_state"
          ]
        }
      },
      "crockpot:grow_up": {
        "remove": {
          "component_groups": [
            "crockpot:volt_goat_baby"
          ]
        }
      },
      "crockpot:become_charged": {
        "set_property": {
          "crockpot:is_charged": true
        },
        "remove": {
          "component_groups": [
            "crockpot:uncharged_state"
          ]
        },
        "add": {
          "component_groups": [
            "crockpot:charged_state"
          ]
        }
      },
      "crockpot:discharge": {
        "set_property": {
          "crockpot:is_charged": false
        },
        "remove": {
          "component_groups": [
            "crockpot:charged_state"
          ]
        },
        "add": {
          "component_groups": [
            "crockpot:uncharged_state"
          ]
        }
      }
    }
  }
}