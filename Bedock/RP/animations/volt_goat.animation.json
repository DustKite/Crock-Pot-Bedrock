{
  "format_version": "1.8.0",
  "animations": {
    "animation.volt_goat.walk": {
      "loop": true,
      "bones": {
        "right_hind_leg": {
          "rotation": [
            "variable.tcos_right_side * 0.5",
            0.0,
            0.0
          ]
        },
        "left_hind_leg": {
          "rotation": [
            "variable.tcos_left_side * 0.5",
            0.0,
            0.0
          ]
        },
        "right_back_leg": {
          "rotation": [
            "variable.tcos_right_side * 0.5",
            0.0,
            0.0
          ]
        },
        "left_back_leg": {
          "rotation": [
            "variable.tcos_left_side * 0.5",
            0.0,
            0.0
          ]
        },
        "right_front_leg": {
          "rotation": [
            "-variable.tcos_right_side * 0.5",
            0.0,
            0.0
          ]
        },
        "left_front_leg": {
          "rotation": [
            "-variable.tcos_left_side * 0.5",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.volt_goat.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": [
            "math.clamp(query.target_x_rotation, -12.0, 12.0)",
            "math.clamp(query.target_y_rotation, -15.0, 15.0)",
            0.0
          ]
        }
      }
    }
  }
}